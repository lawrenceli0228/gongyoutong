{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "../frontend-overrides/checkin-lib.ts",
    "../frontend-overrides/supervision-lib.ts",
    "../frontend-overrides/lang-lib.ts"
  ]
}
