# 工友通(GYT)环境变量样例
#
# 用法:复制成仓库根目录的 .env,填上自己的密钥。
#   cp .env.example .env
# .env 已经在 .gitignore 里,绝对不要提交真实密钥。
#
# 命名规则:后端配置一律以 GYT_ 开头,和 backend/src/gyt/config.py 里的字段名一一对应
# (字段 model_text -> 变量 GYT_MODEL_TEXT)。这里没列出的字段都用代码里的默认值。
#
# 生效方式有两种:
#   1. 在仓库根目录启动进程(pydantic-settings 会自己读同目录的 .env);
#   2. 用 langgraph-cli 启动(backend/langgraph.json 里写了 "env": "../.env",CLI 会先注入)。

# ===== 必填:两家供应商的 API Key =====

# DeepSeek 密钥。申请地址:https://platform.deepseek.com/api_keys
# 供路由 / 任务拆解 / 报告生成 / 知识综合使用(文本模型 deepseek-v4-flash)。
GYT_DEEPSEEK_API_KEY=

# Moonshot(Kimi)密钥。申请地址:https://platform.moonshot.ai/console/api-keys
# 供 Safety 识图和 CAD 预览问答使用(视觉模型 kimi-k3)。
# 注意是国际站 .ai,不是 .cn,两边的 key 不通用。
GYT_MOONSHOT_API_KEY=

# ===== 可选:一般不用改,调试时才动 =====

# 数据根目录。下面会自动派生 uploads / artifacts / cache / chroma 和 gyt.sqlite3。
# 相对路径按进程的工作目录解析。
# GYT_DATA_DIR=data

# 文本模型是否关闭思考模式。路由这类场景要低延迟,默认 true;
# 想看模型的推理过程时可以临时改成 false(会变慢、变贵)。
# GYT_DISABLE_THINKING_FOR_TEXT=true

# Supervisor 熔断步数上限。转来转去超过这个数就停,防止死循环烧额度。
# GYT_SUPERVISOR_RECURSION_LIMIT=8

# LLM 响应磁盘缓存开关。开着能省开发期账单,断网演示时也能复演彩排跑过的路径。
# 想强制打真实接口时改成 false。
# GYT_LLM_CACHE_ENABLED=true

# 提示词版本号,是缓存键的一部分。改了任何提示词就把它往上加一版,
# 否则会命中旧提示词留下的缓存结果。
# GYT_PROMPT_VERSION=v1

# 单次调用超时(秒)与重试次数。重试是指数退避,基准延迟是 GYT_LLM_RETRY_BASE_DELAY_S。
# GYT_LLM_TIMEOUT_S=60.0
# GYT_LLM_MAX_RETRIES=3
# GYT_LLM_RETRY_BASE_DELAY_S=1.0

# 上传文件大小上限(MB)。图纸只收 DXF,DWG 请先离线转换。
# GYT_DRAWING_MAX_MB=64.0
# GYT_DOCUMENT_MAX_MB=10.0
# GYT_PHOTO_MAX_MB=10.0

# ===== 知识库(RAG 规范检索)=====
#
# 规范原文 PDF 放在 data/demo/docs/。首次检索前必须先「建库」:把 PDF 切分、用本地
# BGE-M3 向量化、写进 data/chroma/。**首次建库要下载约 2.2GB 权重 + 抽嵌全书,约 15 分钟
# (一次性;之后 manifest 命中秒过,除非规范文件有增改)。**
#
# 建库方式二选一(详见 backend/README.md「知识库(RAG)建库」一节):
#   · 显式建一次(推荐,尤其容器/生产):  make build-knowledge
#   · 或打开下面这个开关 → 起服务时若索引缺失就自动建。
#     ⚠️ 只适合本地 langgraph dev(无健康检查)。**容器里千万别开** ——
#        15 分钟的启动建库会拖垮 healthcheck(start_period 120s)→ 容器反复重启永不 healthy。
#        容器/生产一律用 make build-knowledge 先把 ./data 卷建好,再 make up。
# GYT_KNOWLEDGE_PREBUILD_AT_STARTUP=false

# 检索候选数、以及「无依据」判定阈值(Chroma 距离,越小越近;最近一条超过它就判查不到)。
# 换语料或换 embedding 模型后要重新标定这个阈值。
# GYT_KNOWLEDGE_TOP_K=5
# GYT_KNOWLEDGE_MAX_DISTANCE=0.85

# ===== 非 GYT_ 前缀,但本项目需要的第三方变量 =====

# HuggingFace 权重下载源。**默认留空(注释掉),不要随手打开。**
#
# 它的默认值定义在 backend/Dockerfile 的 ARG HF_ENDPOINT(官方源),
# docker-compose.yml 只是把这里的值透传过去 —— 也就是说,
# 你在这里填什么,就会覆盖掉 Dockerfile 里那个经过验证的默认值。
#
# 2026-08-06 教训:这一行原本填的是 https://hf-mirror.com,导致镜像构建
# 在下载权重那步必失败(LocalEntryNotFoundError)。原因不是网络不通,
# 而是 hf-mirror.com 已经不再镜像内容,只回一个 308 跳转到 huggingface.co,
# huggingface_hub 的元数据探测在这个跳转上拿不到结果。
# 详细排查记录见 backend/Dockerfile 里 ARG HF_ENDPOINT 上方的注释。
#
# 只有在你**亲自验证过官方源确实下不动、且手上有一个确实能下载的镜像**时,
# 才取消下面这行注释并填上它。验证方法见 backend/README.md「权重下载源失效时怎么办」。
# HF_ENDPOINT=https://<你验证过能用的源>
