.DS_Store
.env
__pycache__/
node_modules/

# ---------------------------------------------------------------------------
# 以下为 T1 骨架补充。上面 4 行是既有内容,保持不动。
# ---------------------------------------------------------------------------

# Python 虚拟环境与打包产物
.venv/
venv/
*.egg-info/
build/
dist/
*.py[cod]

# uv 缓存(默认落在 ~/.cache/uv;若被配置到仓库内则一并忽略)
.uv/
.uv-cache/

# 测试与覆盖率产物
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# 运行期数据目录:sqlite / chroma / uploads / artifacts / cache 一律不进 git。
# 例外:演示数据集 data/demo/ 要留在仓库里(Y 泳道的照片、规范 PDF、DXF 落这儿)。
# 约定:空目录用 .gitkeep 占位,否则 git 记不住目录本身,冷启动会缺目录。
# 注意这里必须写 /data/* 而不是 /data/ —— 后者会让 git 根本不进入该目录,
# 下面那条 ! 例外规则就永远不会生效。
/data/*
!/data/demo/

# 历史遗留目录,**后端已经不写这儿了**(2026-08-09 起)。
#
# 2026-08-09 之前:`Settings.data_dir` 的默认值是相对路径 `Path("data")`,按**进程工作目录**
# 解析,而 `make dev` 的工作目录是 backend/ —— 于是本机落 backend/data/、容器落仓库根 data/,
# 两份数据互相看不见。现在 `_default_data_dir()` 按 config.py 的文件位置推导仓库根,
# 与工作目录无关,两条路径读写同一份。
#
# 这条规则**仍然要留着**:本机上那份旧数据还在,不忽略的话 git 会把它当成一堆待提交的新文件。
# 想彻底清掉用 `backend/scripts/migrate_data_dir.py`(默认只演练,`--apply` 才动手)。
# ⚠️ 别照这条注释去 `rm -f backend/data/gyt.sqlite3` 清台账 —— 那是空操作,
#    真正在用的是仓库根的 `data/gyt.sqlite3`(见 CLAUDE.md 与 live_acceptance.py 头注)。
backend/data/

# langgraph dev 在工作目录下写的本地运行状态(内存库快照、热重载缓存)
.langgraph_api/

# 前端:整个目录都不进 git。
# 它由 scripts/setup-frontend.sh 从上游 langchain-ai/agent-chat-ui clone 生成
# (脚本会剥掉上游 .git)。vendored 一整份进来会让 diff 失控、评审失效,
# 而且别人重跑脚本时会因为 frontend/package.json 已存在而静默跳过 clone,
# 导致所有人长期用的是被冻结在某次提交里的旧代码。
# 写 `/frontend/` 是根锚定:只忽略仓库根的那一个,不会误伤别处同名目录。
# 构建产物(.next/ out/ .turbo/)已被这一条整体覆盖,不必再单列。
/frontend/

# 本地环境变量的各种变体(.env 已在开头忽略);.env.example 必须进 git
.env.*
!.env.example

# 外部数据集的原始下载包与解压目录(Roboflow / Kaggle 等)。
#
# 为什么单列:这类包动辄几百 MB(construction-safety-monitor.v1i.yolov8.zip 是 421MB),
# 而我们从里面**只挑 30 张**进 data/demo/photos/。整包进 git 会让仓库彻底没法 clone,
# 而且 git 对二进制包不做增量,删掉也瘦不回去(历史里永远留着)。
#
# 流程约定:原始包留在本地当工作区,只把**选中并重新标注过**的图拷进 data/demo/photos/。
# 数据来源与许可(CC BY 4.0 要署名)记在 data/demo/README.md 里。
#
# Roboflow 导出的命名规律是 <项目名>.v<版本>i.<格式>.zip
*.v[0-9]*i.*.zip
construction-safety-monitor*/
/datasets/
/*.zip

# 编辑器与系统
.idea/
.vscode/
*.swp

# 本机的 Claude Code 项目说明
/CLAUDE.md
.gstack/

# 个人工作区:规划草稿 / 设计文档 / 私人笔记,不进 git。
/.personal/
